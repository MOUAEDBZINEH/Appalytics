    "\n",
    "if \"Sentiment_Polarity\" in reviews_df.columns:\n",
    "    sentiment_col = \"Sentiment_Polarity\"\n",
    "else:\n",
    "    raise ValueError(\"Sentiment_Polarity في user_reviews\")\n",
